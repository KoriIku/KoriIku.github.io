---
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource-variable/newsreader/wght-italic.css";
import "../styles/global.css";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle =
  title === SITE.title ? `${SITE.title} | ${SITE.tagline}` : `${title} | ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, SITE.url);
const socialImage = image ? new URL(image, SITE.url) : undefined;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15191b" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.js = "true";
        try {
          const saved = localStorage.getItem("kori-theme");
          const preferred = matchMedia("(prefers-color-scheme: dark)").matches
            ? "night"
            : "day";
          root.dataset.theme = saved === "night" || saved === "day" ? saved : preferred;
        } catch {
          root.dataset.theme = "day";
        }
      })();
    </script>
  </head>

  <body id="top">
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
