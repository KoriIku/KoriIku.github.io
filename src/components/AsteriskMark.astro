---
interface Props {
  strokeWidth?: number;
}

const { strokeWidth = 2.5 } = Astro.props;
---

<span aria-hidden="true">
  <svg width="100%" height="100%" viewBox="0 0 32 32" fill="none">
    <path
      d="M16 3v26M4.74 9.5l22.52 13M27.26 9.5 4.74 22.5"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
    />
  </svg>
</span>

<style>
  span {
    display: block;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
