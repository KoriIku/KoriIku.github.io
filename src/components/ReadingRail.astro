---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const chapters = headings.filter((heading) => heading.depth === 2);
---

<nav class="reading-rail" aria-label="阅读进度与章节">
  <span class="reading-rail__bar" aria-hidden="true"></span>

  <div class="reading-rail__chapters">
    {
      chapters.map((chapter, index) => (
        <a
          class="reading-rail__chapter"
          href={`#${chapter.slug}`}
          style={`--chapter-position: ${((index + 1) / (chapters.length + 1)) * 100}%`}
          data-chapter-mark
        >
          <span class="reading-rail__line" aria-hidden="true"></span>
          <span class="reading-rail__label">{chapter.text}</span>
        </a>
      ))
    }
  </div>
</nav>

<script is:inline>
  (() => {
    const article = document.querySelector(".article-body");
    const bar = document.querySelector(".reading-rail__bar");
    const chapterMarks = [...document.querySelectorAll("[data-chapter-mark]")];

    function positionChapterMarks() {
      if (!article || chapterMarks.length === 0) return;

      const articleRect = article.getBoundingClientRect();
      const articleTop = articleRect.top + window.scrollY;
      const articleHeight = articleRect.height;

      for (const mark of chapterMarks) {
        const target = document.getElementById(decodeURIComponent(mark.hash.slice(1)));
        if (!target) continue;

        const targetTop = target.getBoundingClientRect().top + window.scrollY;
        const position = (targetTop - articleTop) / articleHeight;
        const clampedPosition = Math.min(0.96, Math.max(0.04, position));
        mark.style.setProperty("--chapter-position", `${clampedPosition * 100}%`);
      }
    }

    positionChapterMarks();
    document.fonts?.ready.then(positionChapterMarks);

    if (article) {
      const observer = new ResizeObserver(positionChapterMarks);
      observer.observe(article);
    }

    if (!bar || !("ScrollTimeline" in window)) return;

    const timeline = new window.ScrollTimeline({
      source: document.documentElement,
      axis: "block",
    });

    bar.animate(
      [
        { opacity: 0, transform: "scaleY(0)" },
        { opacity: 1, transform: "scaleY(0)", offset: 0.005 },
        { opacity: 1, transform: "scaleY(1)" },
      ],
      { timeline, fill: "both" },
    );

    for (const mark of chapterMarks) {
      mark.animate(
        [{ transform: "translateX(-100%)" }, { transform: "translateX(0)" }],
        {
          timeline,
          fill: "both",
          rangeStart: "0%",
          rangeEnd: "2%",
        },
      );
    }
  })();
</script>

<style>
  .reading-rail__bar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 10;
    width: 32px;
    height: 100dvh;
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top center;
    pointer-events: none;
  }

  .reading-rail__chapters {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 11;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .reading-rail__chapter {
    position: fixed;
    top: var(--chapter-position);
    left: 0;
    display: flex;
    align-items: flex-start;
    color: var(--ink);
    opacity: 0.9;
    text-decoration: none;
    transform: translateX(-100%);
    pointer-events: auto;
  }

  .reading-rail__line {
    width: 46px;
    height: 12px;
    flex: none;
    margin-top: -6px;
    border-bottom: 1px solid currentColor;
  }

  .reading-rail__label {
    max-width: 260px;
    margin-left: 6px;
    padding: 7px 10px 7px 5px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.45;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .reading-rail__chapter:hover .reading-rail__label,
  .reading-rail__chapter:focus-visible .reading-rail__label {
    opacity: 1;
    transform: translateX(0);
  }

  .reading-rail__chapter:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 4px;
  }

  @media (max-width: 1024px) {
    .reading-rail__bar {
      width: 24px;
    }

    .reading-rail__line {
      width: 32px;
    }

    .reading-rail__label {
      max-width: 220px;
      font-size: 11px;
    }
  }

  @media (max-width: 768px) {
    .reading-rail__bar {
      width: 10px;
    }

    .reading-rail__chapters {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-rail__bar {
      display: none;
    }
  }
</style>
