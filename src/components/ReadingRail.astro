---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const chapters = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 4,
);
---

<nav class="reading-rail" aria-label="阅读进度与章节">
  <span class="reading-rail__bar" aria-hidden="true"></span>

  <div class="reading-rail__chapters">
    {
      chapters.map((chapter, index) => (
        <a
          class="reading-rail__chapter"
          href={`#${chapter.slug}`}
          style={`--chapter-position: ${((index + 1) / (chapters.length + 1)) * 100}%`}
          data-depth={chapter.depth}
          data-chapter-mark
        >
          <span class="reading-rail__line" aria-hidden="true"></span>
          <span class="reading-rail__label">{chapter.text}</span>
        </a>
      ))
    }
  </div>
</nav>

<script is:inline>
  (() => {
    const bar = document.querySelector(".reading-rail__bar");
    const chapterMarks = [...document.querySelectorAll("[data-chapter-mark]")];
    const scrollElement = document.scrollingElement ?? document.documentElement;

    function positionChapterMarks() {
      const article = document.querySelector(".article-body");
      if (!article || chapterMarks.length === 0) return;

      const maxScroll = Math.max(1, scrollElement.scrollHeight - window.innerHeight);

      for (const mark of chapterMarks) {
        const target = document.getElementById(decodeURIComponent(mark.hash.slice(1)));
        if (!target) continue;

        const targetTop = target.getBoundingClientRect().top + window.scrollY;
        const readingOffset =
          Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        const position = (targetTop - readingOffset) / maxScroll;
        const clampedPosition = Math.min(0.96, Math.max(0.04, position));
        mark.style.setProperty("--chapter-position", `${clampedPosition * 100}%`);
      }
    }

    function initializeChapterRail() {
      positionChapterMarks();

      const article = document.querySelector(".article-body");
      if (!article) return;

      const resizeObserver = new ResizeObserver(positionChapterMarks);
      resizeObserver.observe(article);
      window.addEventListener("resize", positionChapterMarks, { passive: true });

      const sectionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;

            for (const mark of chapterMarks) {
              const isActive =
                mark.hash === `#${encodeURIComponent(entry.target.id)}`;
              mark.classList.toggle("is-active", isActive);
              if (isActive) {
                mark.setAttribute("aria-current", "location");
              } else {
                mark.removeAttribute("aria-current");
              }
            }
          }
        },
        { rootMargin: "-15% 0px -75% 0px" },
      );

      for (const mark of chapterMarks) {
        const target = document.getElementById(decodeURIComponent(mark.hash.slice(1)));
        if (target) sectionObserver.observe(target);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeChapterRail, { once: true });
    } else {
      initializeChapterRail();
    }

    document.fonts?.ready.then(positionChapterMarks);

    if (!bar || !("ScrollTimeline" in window)) return;

    const timeline = new window.ScrollTimeline({
      source: document.documentElement,
      axis: "block",
    });

    bar.animate(
      [
        { opacity: 0, transform: "scaleY(0)" },
        { opacity: 1, transform: "scaleY(0)", offset: 0.005 },
        { opacity: 1, transform: "scaleY(1)" },
      ],
      { timeline, fill: "both" },
    );

    for (const mark of chapterMarks) {
      mark.animate(
        [{ transform: "translateX(-100%)" }, { transform: "translateX(0)" }],
        {
          timeline,
          fill: "both",
          rangeStart: "0%",
          rangeEnd: "2%",
        },
      );
    }
  })();
</script>

<style>
  .reading-rail__bar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 10;
    width: 32px;
    height: 100dvh;
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top center;
    pointer-events: none;
  }

  .reading-rail__chapters {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 11;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .reading-rail__chapter {
    position: fixed;
    top: var(--chapter-position);
    left: 0;
    display: grid;
    grid-template-columns: 46px max-content;
    align-items: flex-start;
    color: var(--ink);
    opacity: 0.9;
    text-decoration: none;
    transform: translateX(-100%);
    pointer-events: auto;
  }

  .reading-rail__line {
    width: 46px;
    height: 12px;
    margin-top: -6px;
    border-bottom: 1px solid currentColor;
    justify-self: start;
    transition:
      border-color 160ms ease,
      border-width 160ms ease,
      opacity 160ms ease;
  }

  .reading-rail__chapter[data-depth="3"] {
    opacity: 0.72;
  }

  .reading-rail__chapter[data-depth="3"] .reading-rail__line {
    width: 33px;
  }

  .reading-rail__chapter[data-depth="4"] {
    opacity: 0.5;
  }

  .reading-rail__chapter[data-depth="4"] .reading-rail__line {
    width: 20px;
  }

  .reading-rail__chapter.is-active {
    color: var(--accent-strong);
    opacity: 1;
  }

  .reading-rail__chapter.is-active .reading-rail__line {
    border-bottom-width: 2px;
  }

  .reading-rail__label {
    max-width: 260px;
    margin-left: 6px;
    padding: 7px 10px 7px 5px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.45;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .reading-rail__chapter:hover .reading-rail__label,
  .reading-rail__chapter:focus-visible .reading-rail__label {
    opacity: 1;
    transform: translateX(0);
  }

  .reading-rail__chapter:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 4px;
  }

  @media (max-width: 1024px) {
    .reading-rail__bar {
      width: 24px;
    }

    .reading-rail__chapter {
      grid-template-columns: 32px max-content;
    }

    .reading-rail__line {
      width: 32px;
    }

    .reading-rail__chapter[data-depth="3"] .reading-rail__line {
      width: 23px;
    }

    .reading-rail__chapter[data-depth="4"] .reading-rail__line {
      width: 14px;
    }

    .reading-rail__label {
      max-width: 220px;
      font-size: 11px;
    }
  }

  @media (max-width: 768px) {
    .reading-rail__bar {
      width: 10px;
    }

    .reading-rail__chapters {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-rail__bar {
      display: none;
    }
  }
</style>
