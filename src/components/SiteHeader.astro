---
import { NAV_ITEMS } from "../consts";
import AsteriskMark from "./AsteriskMark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="Kori 首页">
      <span>kori</span><span class="wordmark__mark"><AsteriskMark strokeWidth={3.2} /></span>
    </a>

    <nav aria-label="主导航">
      <ul>
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  pathname === item.href ||
                  pathname.startsWith(item.href)
                    ? "page"
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    min-height: 76px;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 32px;
    align-items: center;
    width: min(calc(100% - 48px), var(--page));
    min-height: 76px;
    margin-inline: auto;
  }

  .wordmark {
    display: inline-flex;
    gap: 2px;
    align-items: center;
    width: fit-content;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 30px;
    font-style: italic;
    font-weight: 520;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  .wordmark__mark {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin-top: 3px;
    color: var(--accent);
  }

  nav ul {
    display: flex;
    gap: 24px;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--ink-muted);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
    transition: color 160ms ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .site-header,
    .site-header__inner {
      min-height: 64px;
    }

    .site-header__inner {
      grid-template-columns: 1fr auto auto;
      gap: 18px;
      width: calc(100% - 40px);
    }

    .wordmark {
      font-size: 26px;
    }

    nav ul {
      gap: 16px;
    }

    nav a {
      font-size: 13px;
    }
  }

  @media (max-width: 479px) {
    .site-header__inner {
      gap: 12px;
      width: calc(100% - 36px);
    }

    .wordmark {
      font-size: 24px;
    }

    nav ul {
      gap: 12px;
    }

    nav a {
      font-size: 12.5px;
    }
  }
</style>
